# ==============================================================================
# POP!_OS WORKSTATION CONFIGURATION
# Copy this file to 'config.env' and modify it with your preferences.
# 'config.env' is ignored by Git to keep your identity and paths private.
# ==============================================================================

# Git & GitHub Identity
GIT_NAME="Your Full Name"
GIT_EMAIL="your.email@example.com"
GITHUB_USER="your-github-username"

# Optional: GPG Passphrase (if empty, you will be prompted securely during setup)
# GPG_PASSPHRASE=""

# Dotfiles & Editor Repositories
DOTFILES_REPO="https://github.com/your-username/dotfiles.git"
NVIM_CONFIG_REPO="https://github.com/your-username/astronvim_v6"
