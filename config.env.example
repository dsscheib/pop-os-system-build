# Copy to config.env. This is sourced Bash code; use only a trusted local file.
# The user configuration file is ignored by Git. Do not commit credentials.

# Required for the git stage. No author identity is supplied by default.
GIT_NAME="Your Full Name"
GIT_EMAIL="your.email@example.com"

# Required only for the corresponding dotfiles/neovim stages.
DOTFILES_REPO="https://github.com/your-username/dotfiles.git"
NVIM_CONFIG_REPO="https://github.com/your-username/astronvim_v6"
# Optional immutable refs for your own repositories (otherwise clean checkouts
# update with --ff-only, and the selected commit is printed).
# DOTFILES_REF="commit-sha"
# NVIM_CONFIG_REF="commit-sha"

# Optional private-dotfiles stage: a private repository with restore.sh that copies
# personal agent configuration into place. Leave unset to skip the stage. Cloning
# uses the GitHub CLI sign-in from the git stage.
# PRIVATE_DOTFILES_REPO="https://github.com/your-username/dotfiles-private.git"
# PRIVATE_DOTFILES_REF="commit-sha"

# For STM32 scripts, export this in your shell (they do not source config.env).
# Installers also search this location, in addition to $PWD and ~/Downloads.
# ST_DOWNLOAD_DIR="$HOME/github/st-microelectronics"
# A new/unrecognized installer requires a reviewed SHA-256 explicitly supplied
# as ST_INSTALLER_SHA256, or an updated resources/st-installers.sha256 manifest.
