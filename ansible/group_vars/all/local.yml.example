---
# Copy to ansible/group_vars/all/local.yml (gitignored) for per-machine overrides.

# Private Chezmoi dotfiles repository (cloned via gh or SSH)
# dotfiles_repo: "https://github.com/your-username/dotfiles.git"

# Neovim configuration repository
# nvim_config_repo: "https://github.com/your-username/astronvim_v6"
# nvim_config_ref: ""

# Snapper runs by default (set enable_snapper: false on non-Btrfs hosts);
# enable_hibernation is opt-in (set true on laptops)
# enable_snapper: false
# enable_hibernation: true

# Install Samsung 970 EVO NVMe power-management udev rule (PCI 0000:00:1d.0)
# install_samsung_970_evo_nvme_rule: true
