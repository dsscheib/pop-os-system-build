---
# Copy to ansible/group_vars/all/local.yml (gitignored) for per-machine overrides.

# Private Chezmoi dotfiles repository. Use the HTTPS URL: `mise run auth` signs
# in with the GitHub CLI first, and a fresh machine has no SSH keys yet.
# dotfiles_repo: "https://github.com/your-username/dotfiles.git"

# Neovim configuration repository (HTTPS). The first `mise run apply` clones it
# before any GitHub sign-in, so leave it unset until after `mise run auth` if the
# repo is private.
# nvim_config_repo: "https://github.com/your-username/astronvim_v6"
# nvim_config_ref: ""

# Snapper runs by default (set enable_snapper: false on non-Btrfs hosts);
# enable_hibernation is opt-in (set true on laptops)
# enable_snapper: false
# enable_hibernation: true

# Install Samsung 970 EVO NVMe power-management udev rule (PCI 0000:00:1d.0)
# install_samsung_970_evo_nvme_rule: true

# cosmic-swipe (four-finger up/down gestures) installs on every COSMIC desktop; set false
# on a machine where you don't want it, or everywhere once COSMIC ships the gestures itself
# install_cosmic_swipe: false
