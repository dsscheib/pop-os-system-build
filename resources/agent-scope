#!/usr/bin/env bash
# Run an AI agent CLI in its own systemd user scope. A runaway process tree under
# the agent then hits the scope's task and memory limits, and OOMPolicy=kill ends
# the whole agent tree instead of exhausting RAM and swap for the desktop.
# Override the limits with POP_AGENT_TASKS_MAX, POP_AGENT_MEMORY_MAX (bytes or a
# percentage of RAM) and POP_AGENT_SWAP_MAX (bytes).
set -euo pipefail
(( $# )) || { echo 'Usage: agent-scope COMMAND [ARGUMENT...]' >&2; exit 2; }
# An agent started by another agent stays inside the outer scope and its limits.
# Without a user service manager (for example over plain SSH), run unconfined.
if [[ -n ${POP_AGENT_SCOPE:-} || -z ${XDG_RUNTIME_DIR:-} || ! -S $XDG_RUNTIME_DIR/bus ]] \
  || ! command -v systemd-run >/dev/null; then
  exec "$@"
fi
export POP_AGENT_SCOPE=1
exec systemd-run --user --scope --quiet --collect --unit="agent-${1##*/}-$$" \
  -p TasksMax="${POP_AGENT_TASKS_MAX:-2048}" \
  -p MemoryMax="${POP_AGENT_MEMORY_MAX:-50%}" \
  -p MemorySwapMax="${POP_AGENT_SWAP_MAX:-8G}" \
  -p OOMPolicy=kill \
  -- "$@"
